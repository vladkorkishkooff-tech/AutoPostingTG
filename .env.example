BOT_TOKEN=1234567890:telegram_bot_token
CHANNEL_ID=@your_channel
CHANNEL_URL=https://t.me/your_channel
WEB_APP_URL=

# Shared production database and Mini App security. Generate each secret with:
# openssl rand -hex 32
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
KEYS_ENCRYPTION_SECRET=
BRIDGE_SECRET=
BRIDGE_PORT=

# Нужно, если с твоей сети нет прямого доступа к api.telegram.org.
# Примеры:
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=

# Proxy для LLM и image API. Если пусто, используется TELEGRAM_PROXY_URL.
# Для твоего текущего VPN это, вероятно, http://127.0.0.1:10809
OUTBOUND_PROXY_URL=

# Без ключей LLM бот тоже запустится и будет использовать локальные fallback-тексты.
# Для бесплатного портфолио-режима начни с Groq.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,gemma2-9b-it,qwen/qwen3-32b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_MODELS=meta/llama-3.1-8b-instruct,mistralai/mistral-7b-instruct-v0.3,google/gemma-2-9b-it

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_MODELS=z-ai/glm-4.5-air:free,qwen/qwen3-14b:free,meta-llama/llama-3.2-3b-instruct:free

# Для любого OpenAI-compatible API.
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_MODEL=

# v0 Platform API — отдельный тестовый провайдер. Он использует API чатов,
# а не OpenAI-compatible /chat/completions.
V0_API_KEY=
V0_MODEL=v0-mini

# Порядок перебора LLM.
LLM_PROVIDER_ORDER=gemini,groq,mistral,nvidia,openrouter,custom,local

# --- Платный путь: раскомментируйте нужный блок и вставьте свои ключи ---
# Платные API обычно стабильнее бесплатных лимитов, но требуют оплаты.
#
# OpenAI-compatible custom endpoint:
# CUSTOM_OPENAI_API_KEY=sk-your-paid-api-key
# CUSTOM_OPENAI_BASE_URL=https://api.openai.com/v1
# CUSTOM_OPENAI_MODELS=gpt-4o-mini,gpt-4.1-mini
# LLM_PROVIDER_ORDER=custom,groq,nvidia,openrouter,local
#
# Gemini:
# GEMINI_API_KEYS=first-key,second-key
# GEMINI_MODELS=gemini-3.5-flash
# LLM_PROVIDER_ORDER=gemini,groq,nvidia,openrouter,local
#
# Mistral:
# MISTRAL_API_KEY=your-mistral-api-key
# MISTRAL_MODELS=mistral-small-latest,mistral-medium-latest
# LLM_PROVIDER_ORDER=mistral,groq,nvidia,openrouter,local
#
# OpenRouter paid models:
# OPENROUTER_API_KEY=sk-or-v1-your-key
# OPENROUTER_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001,anthropic/claude-3.5-haiku
# LLM_PROVIDER_ORDER=openrouter,groq,nvidia,local
#
# NVIDIA:
# NVIDIA_API_KEY=nvapi-your-key
# NVIDIA_MODELS=meta/llama-3.1-70b-instruct,meta/llama-3.1-8b-instruct
# LLM_PROVIDER_ORDER=nvidia,groq,openrouter,local

DEFAULT_TOPIC=наука
DEFAULT_MODE=normal
POST_STYLE_EXAMPLE=🤬 В японском языке нет ругательств сильнее, чем «дурак» и «идиот»
POST_INTERVAL_HOURS=24
POST_ON_STARTUP=false
DISABLE_PERIODIC_POSTING=false

# Обязательный allow-list владельцев Mini App и администраторов команд бота.
# Формат: 123456789,987654321. В production нельзя оставлять пустым.
ADMIN_USER_IDS=

# Изображения. Wikimedia работает без ключа. NASA DEMO_KEY работает, но с лимитами.
NASA_API_KEY=DEMO_KEY
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

REQUEST_TIMEOUT_SECONDS=30
MAX_IMAGE_BYTES=8000000

# История нужна, чтобы бот не повторял недавние тексты и фотографии.
HISTORY_FILE=data/content_history.json
HISTORY_LIMIT=500
RECENT_POST_LIMIT=40
RECENT_IMAGE_LIMIT=60
GENERATION_ATTEMPTS=4
