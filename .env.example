BOT_TOKEN=1234567890:telegram_bot_token
CHANNEL_ID=@your_channel
CHANNEL_URL=https://t.me/your_channel

# Нужно, если с твоей сети нет прямого доступа к api.telegram.org.
# Примеры:
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080
TELEGRAM_PROXY_URL=

# Proxy для LLM и image API. Если пусто, используется TELEGRAM_PROXY_URL.
# Для твоего текущего VPN это, вероятно, http://127.0.0.1:10809
OUTBOUND_PROXY_URL=

# Без ключей LLM бот тоже запустится и будет использовать локальные fallback-тексты.
# Для бесплатного портфолио-режима начни с Groq.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3-32b
GROQ_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,gemma2-9b-it,qwen/qwen3-32b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_MODELS=meta/llama-3.1-8b-instruct,mistralai/mistral-7b-instruct-v0.3,google/gemma-2-9b-it

OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.5-air:free
OPENROUTER_MODELS=z-ai/glm-4.5-air:free,qwen/qwen3-14b:free,meta-llama/llama-3.2-3b-instruct:free

# Для любого OpenAI-compatible API.
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_MODEL=

# Порядок перебора LLM. local всегда работает без API.
LLM_PROVIDER_ORDER=groq,mistral,gemini,nvidia,openrouter,custom,local

DEFAULT_TOPIC=наука
POST_INTERVAL_HOURS=24
POST_ON_STARTUP=false
DISABLE_PERIODIC_POSTING=false

# Если оставить пустым, командами сможет пользоваться любой пользователь.
# Формат: 123456789,987654321
ADMIN_USER_IDS=

# Изображения. Wikimedia работает без ключа. NASA DEMO_KEY работает, но с лимитами.
NASA_API_KEY=DEMO_KEY
PIXABAY_API_KEY=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

REQUEST_TIMEOUT_SECONDS=30
MAX_IMAGE_BYTES=8000000
